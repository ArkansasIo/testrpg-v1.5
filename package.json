{
  "name": "taskbar-hero-clone",
  "version": "0.1.1",
  "description": "Taskbar-docked idle RPG prototype built with Electron and PixiJS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check:syntax": "node --check main.js && node --check preload.js && node --check preload-inventory.js && node --check preload-settings.js && find src -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check:json": "node -e \"JSON.parse(require('fs').readFileSync('package.json','utf8'))\"",
    "check": "npm run check:syntax && npm run check:json && npm test",
    "pack:dir": "electron-builder --dir",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "pixi.js": "^7.4.2"
  },
  "build": {
    "appId": "io.arkansas.taskbarhero",
    "productName": "Taskbar Hero",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-inventory.js",
      "preload-settings.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/app-icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
